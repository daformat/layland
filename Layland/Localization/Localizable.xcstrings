    "Showing sample data with every file category while the palette editor is open. Close the editor to return to your scan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض بيانات نموذجية تضم كل فئات الملفات ما دام محرر اللوحة مفتوحًا. أغلق المحرر للعودة إلى الفحص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange der Paletteneditor geöffnet ist, werden Beispieldaten mit allen Dateikategorien gezeigt. Schließe den Editor, um zu deinem Scan zurückzukehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestran datos de ejemplo con todas las categorías de archivo mientras el editor de paletas está abierto. Cierra el editor para volver a tu análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données d’exemple avec toutes les catégories de fichiers, tant que l’éditeur de palette est ouvert. Fermez l’éditeur pour revenir à votre analyse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैलेट एडिटर खुला रहने तक हर फ़ाइल श्रेणी वाला नमूना डेटा दिखाया जा रहा है। अपने स्कैन पर लौटने के लिए एडिटर बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre l'editor della tavolozza è aperto vengono mostrati dati di esempio con tutte le categorie di file. Chiudi l'editor per tornare alla scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パレットエディタを開いている間は、すべてのファイルカテゴリを含むサンプルデータを表示しています。エディタを閉じるとスキャンに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔레트 편집기가 열려 있는 동안 모든 파일 카테고리가 포함된 샘플 데이터를 표시합니다. 편집기를 닫으면 스캔으로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zolang de paleteditor open is, worden voorbeeldgegevens met elke bestandscategorie getoond. Sluit de editor om terug te gaan naar je scan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibindo dados de exemplo com todas as categorias de arquivo enquanto o editor de paletas estiver aberto. Feche o editor para voltar à sua análise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока открыт редактор палитры, показаны образцы данных со всеми категориями файлов. Закройте редактор, чтобы вернуться к сканированию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palet düzenleyici açıkken tüm dosya kategorilerini içeren örnek veriler gösteriliyor. Taramanıza dönmek için düzenleyiciyi kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки відкрито редактор палітри, показано зразкові дані з усіма категоріями файлів. Закрийте редактор, щоб повернутися до сканування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang hiển thị dữ liệu mẫu với mọi loại tệp trong khi trình sửa bảng màu đang mở. Đóng trình sửa để quay lại bản quét của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调色板编辑器打开期间，将显示包含所有文件类别的示例数据。关闭编辑器即可返回你的扫描。"
          }
        }
      }
    },
