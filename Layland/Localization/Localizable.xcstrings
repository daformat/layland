    "Gumroad couldn't be reached, so the key works until %@ and will be checked when you're online." : {
      "comment" : "The argument is a date and time",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الاتصال بـ Gumroad، لذا يعمل المفتاح حتى %@ وسيتم التحقق منه عند اتصالك بالإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumroad war nicht erreichbar. Der Schlüssel funktioniert daher bis %@ und wird geprüft, sobald du online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conectar con Gumroad, así que la clave funcionará hasta el %@ y se comprobará cuando tengas conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre Gumroad : la clé fonctionne jusqu’au %@ et sera vérifiée dès que vous serez en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumroad से संपर्क नहीं हो सका, इसलिए कुंजी %@ तक काम करेगी और आपके ऑनलाइन होने पर जाँची जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile contattare Gumroad: la chiave funziona fino al %@ e verrà verificata quando sarai online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumroadに接続できなかったため、キーは%@まで有効です。オンラインになったときに確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumroad에 연결할 수 없어 키는 %@까지 작동하며, 온라인 상태가 되면 확인됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumroad was niet bereikbaar, dus de sleutel werkt tot %@ en wordt gecontroleerd zodra je online bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível contatar o Gumroad, então a chave funciona até %@ e será verificada quando você estiver online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с Gumroad, поэтому ключ будет работать до %@ и будет проверен, когда вы подключитесь к интернету."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumroad'a ulaşılamadı; anahtar %@ tarihine kadar çalışır ve çevrimiçi olduğunuzda denetlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося звʼязатися з Gumroad, тож ключ працюватиме до %@ і буде перевірений, коли ви підключитеся до інтернету."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối với Gumroad, nên khóa vẫn dùng được đến %@ và sẽ được kiểm tra khi bạn trực tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 Gumroad，因此此密钥在 %@ 之前有效，并将在你联网后进行验证。"
          }
        }
      }
    },
