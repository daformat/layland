      }
    },
    "That doesn't look like a license key. It has 32 letters and digits, in four groups." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يبدو هذا مفتاح ترخيص. يتكون المفتاح من 32 حرفًا ورقمًا في أربع مجموعات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nicht nach einem Lizenzschlüssel aus. Er besteht aus 32 Buchstaben und Ziffern in vier Gruppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso no parece una clave de licencia. Tiene 32 letras y cifras, en cuatro grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ne ressemble pas à une clé de licence. Elle comporte 32 lettres et chiffres, en quatre groupes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लाइसेंस कुंजी जैसी नहीं लगती। इसमें चार समूहों में 32 अक्षर और अंक होते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sembra una chiave di licenza. È composta da 32 lettere e cifre, in quattro gruppi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンスキーではないようです。ライセンスキーは4つのグループに分かれた32文字の英数字です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이선스 키가 아닌 것 같습니다. 라이선스 키는 4개 그룹으로 된 32자의 문자와 숫자입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat lijkt geen licentiesleutel. Die bestaat uit 32 letters en cijfers, in vier groepen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não parece uma chave de licença. Ela tem 32 letras e algarismos, em quatro grupos."
          }
        },
        "ru" : {
          "stringUnit" : {
