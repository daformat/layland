    "Hover over the map to inspect items. Double-click a folder to zoom in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر المؤشر فوق الخريطة لمعاينة العناصر. انقر مرتين على مجلد لتكبيره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Zeiger über die Karte, um Objekte zu untersuchen. Doppelklicke auf einen Ordner, um ihn zu vergrößern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el puntero sobre el mapa para inspeccionar los elementos. Haz doble clic en una carpeta para ampliarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez la carte pour inspecter les éléments. Double-cliquez sur un dossier pour zoomer dessus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइटम देखने के लिए पॉइंटर को मैप पर ले जाएँ। ज़ूम इन करने के लिए किसी फ़ोल्डर पर डबल-क्लिक करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa il puntatore sulla mappa per esaminare gli elementi. Fai doppio clic su una cartella per ingrandirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップ上にポインタを置くと項目を確認できます。フォルダをダブルクリックすると拡大します。"
