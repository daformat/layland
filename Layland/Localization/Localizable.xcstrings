    "For a complete picture, grant Layland Full Disk Access in System Settings → Privacy & Security." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للحصول على صورة كاملة، امنح Layland الوصول الكامل إلى القرص في إعدادات النظام → الخصوصية والأمن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für ein vollständiges Bild gib Layland Festplattenvollzugriff unter Systemeinstellungen → Datenschutz & Sicherheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para obtener una visión completa, concede a Layland acceso total al disco en Ajustes del Sistema → Privacidad y seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une vue complète, accordez l’accès complet au disque à Layland dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी तस्वीर के लिए, सिस्टम सेटिंग्ज़ → गोपनीयता और सुरक्षा में Layland को पूर्ण डिस्क ऐक्सेस दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un quadro completo, concedi a Layland l'accesso completo al disco in Impostazioni di Sistema → Privacy e sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてを表示するには、「システム設定」→「プライバシーとセキュリティ」でLaylandにフルディスクアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체를 보려면 시스템 설정 → 개인정보 보호 및 보안에서 Layland에 전체 디스크 접근 권한을 부여하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Layland voor een volledig beeld volledige schijftoegang in Systeeminstellingen → Privacy en beveiliging."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para uma visão completa, conceda Acesso Total ao Disco ao Layland em Ajustes do Sistema → Privacidade e Segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы увидеть полную картину, предоставьте Layland полный доступ к диску: Системные настройки → Конфиденциальность и безопасность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam bir görünüm için Sistem Ayarları → Gizlilik ve Güvenlik bölümünde Layland uygulamasına Tam Disk Erişimi verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб побачити повну картину, надайте Layland повний доступ до диска: Системні параметри → Приватність і безпека."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để thấy toàn cảnh, hãy cấp cho Layland quyền Truy cập toàn bộ ổ đĩa trong Cài đặt hệ thống → Quyền riêng tư & Bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要查看完整情况，请在“系统设置”→“隐私与安全性”中为 Layland 授予完全磁盘访问权限。"
          }
        }
      }
    },
    "Free" : {
