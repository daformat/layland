{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is not a folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ليس مجلدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas un dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ फ़ोल्डर नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è una cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はフォルダではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 폴더가 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen map."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é uma pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не является папкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir klasör değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не є папкою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không phải là thư mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是文件夹。"
          }
        }
      }
    },
    "%@ will be moved to the Trash. You can restore it from the Trash until you empty it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقل %@ إلى سلة المهملات. يمكنك استعادته من سلة المهملات إلى أن تفرغها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird in den Papierkorb gelegt. Du kannst es von dort wiederherstellen, bis du den Papierkorb entleerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se trasladará a la Papelera. Podrás recuperarlo de la Papelera hasta que la vacíes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera placé dans la corbeille. Vous pourrez l’y récupérer tant que vous ne l’aurez pas vidée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को ट्रैश में ले जाया जाएगा। जब तक आप ट्रैश ख़ाली नहीं करते, आप इसे वहाँ से वापस ला सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verrà spostato nel Cestino. Potrai ripristinarlo dal Cestino finché non lo svuoti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はゴミ箱に移動されます。ゴミ箱を空にするまでは元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 휴지통으로 이동됩니다. 휴지통을 비우기 전까지는 복원할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt naar de prullenmand verplaatst. Je kunt het terugzetten tot je de prullenmand leegmaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será movido para o Lixo. Você pode recuperá-lo no Lixo até esvaziá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объект %@ будет перемещен в Корзину. Его можно восстановить, пока Корзина не очищена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Çöp Sepeti'ne taşınacak. Çöp Sepeti'ni boşaltana kadar geri yükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обʼєкт %@ буде переміщено в Смітник. Його можна відновити, доки Смітник не очищено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ được chuyển vào Thùng rác. Bạn có thể khôi phục mục này từ Thùng rác cho đến khi dọn sạch Thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将被移到废纸篓。在倒空废纸篓之前，你可以将其复原。"
          }
        }
      }
    },
