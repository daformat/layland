    "%lld folders couldn't be read. Grant Layland Full Disk Access to include them, then rescan." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذرت قراءة %lld مجلدات. امنح Layland الوصول الكامل إلى القرص لتضمينها، ثم أعد الفحص."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذرت قراءة %lld مجلدًا. امنح Layland الوصول الكامل إلى القرص لتضمينها، ثم أعد الفحص."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذرت قراءة %lld مجلد. امنح Layland الوصول الكامل إلى القرص لتضمينه، ثم أعد الفحص."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذرت قراءة %lld مجلد. امنح Layland الوصول الكامل إلى القرص لتضمينها، ثم أعد الفحص."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذرت قراءة %lld مجلدين. امنح Layland الوصول الكامل إلى القرص لتضمينهما، ثم أعد الفحص."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذرت قراءة %lld مجلد. امنح Layland الوصول الكامل إلى القرص لتضمينها، ثم أعد الفحص."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
