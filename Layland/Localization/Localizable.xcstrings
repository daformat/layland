    "Logical size counts bytes as reported; size on disk counts allocated blocks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب الحجم المنطقي البايتات كما يُبلَّغ عنها، ويحسب الحجم على القرص الكتل المخصّصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die logische Größe zählt die gemeldeten Bytes, die Größe auf dem Volume die belegten Blöcke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño lógico cuenta los bytes declarados; el tamaño en disco cuenta los bloques asignados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille logique compte les octets déclarés ; la taille sur le disque compte les blocs alloués."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तार्किक आकार रिपोर्ट किए गए बाइट गिनता है; डिस्क पर आकार आवंटित ब्लॉक गिनता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dimensione logica conta i byte dichiarati; la dimensione su disco conta i blocchi allocati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "論理サイズは報告されたバイト数を、ディスク上のサイズは割り当てられたブロックを数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "논리적 크기는 보고된 바이트 수를, 디스크상 크기는 할당된 블록을 계산합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logische grootte telt de gemelde bytes; grootte op schijf telt de toegewezen blokken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho lógico conta os bytes informados; o tamanho em disco conta os blocos alocados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логический размер учитывает заявленные байты, а размер на диске учитывает выделенные блоки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantıksal boyut bildirilen baytları sayar; diskteki boyut ayrılmış blokları sayar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Логічний розмір враховує заявлені байти, а розмір на диску враховує виділені блоки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích thước logic tính số byte được báo cáo; kích thước trên ổ đĩa tính các khối được cấp phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逻辑大小按报告的字节数计算；磁盘上的大小按已分配的块计算。"
          }
        }
      }
    },
