    "NSDesktopFolderUsageDescription" : {
      "comment" : "macOS shows this when Layland first reads that place, under the question whether it may",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس Layland حجم الملفات في مجلد سطح المكتب لديك."
